# 复制为同目录的 .env 再填真实值。compose 读它取镜像与端口，migrate / server 容器也整份加载它。

# 镜像来源与版本；升级时改 IMAGE_TAG 再 docker compose up -d。
ACR_REGISTRY=registry.cn-shenzhen.aliyuncs.com
ACR_NAMESPACE=docker-mmt
IMAGE_TAG=latest

# 对外端口。改了它，SSO_REDIRECT_URL 里的端口也要跟着改。
WEB_PORT=80

# 服务器现有 Postgres 上为本项目单独建的数据库与账号（建库 SQL 见 README 部署一节）。
# 表建在这个库的 iclip、agent_runtime 与 public 三个 schema 里，不与别的项目共用数据库。
# Postgres 跑在宿主机上时主机名写 host.docker.internal；跑在别的容器里写它的地址。
DATABASE_URL=postgresql+asyncpg://iclip:change-me@host.docker.internal:5432/iclip

# 会话签名密钥，至少 32 个字符的随机串。
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# 模型：configs/config.yaml 里 models.*.api_key_env 指向的变量
MODEL_API_KEY=

# SSO（留空即关闭）。回调地址是对外访问地址 + /auth/sso/landing。
SSO_BASE_URL=
SSO_REDIRECT_URL=http://60.171.194.72/auth/sso/landing
PMS_BASE_URL=
# 这个邮箱 SSO 首次登录即 root；不走 SSO 用 scripts.admin set-roles 引导。
ROOT_EMAIL=

# 公开对象存储（留空即关闭；开了媒体生成就必须有）
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL_BASE=

# 媒体生成（VIDEO_SUBMIT_URL 留空即关闭；填了这一组都要填）
VIDEO_SUBMIT_URL=
VIDEO_STATUS_BASE_URL=
VIDEO_API_KEY=
IMAGE_API_BASE=

# 镜头素材能力（留空即关闭；要开必须先开媒体生成）。仓内 storyboard agent 依赖它。
VIDEO_UNDERSTANDING_URL=
VIDEO_UNDERSTANDING_API_KEY=

# PDM 款目录外部只读库（留空即关闭，爆款视频降级不可用）
PRODUCT_CATALOG_DATABASE_URL=
