# 复制为 .env 并填入真实值；YAML 配置只引用这些变量名。
ICLIP_DATABASE_URL=postgresql+asyncpg://iclip:iclip@localhost:5432/iclip
ICLIP_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# SSO（可选：留空即关闭）
WANGOON_SSO_BASE_URL=
ICLIP_SSO_REDIRECT_URL=
WANGOON_PMS_BASE_URL=

# 测试：显式指定则优先于 testcontainers
# ICLIP_TEST_DATABASE_URL=postgresql+asyncpg://iclip:iclip@localhost:5432/iclip_test
